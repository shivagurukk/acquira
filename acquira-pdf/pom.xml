<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.acquira</groupId><artifactId>acquira-parent</artifactId><version>1.0.0-SNAPSHOT</version></parent>
    <artifactId>acquira-pdf</artifactId>
    <description>Playwright-based PDF generation engine</description>
    <dependencies>
        <dependency><groupId>com.acquira</groupId><artifactId>acquira-common</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-thymeleaf</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-batch</artifactId></dependency>
        <dependency><groupId>com.microsoft.playwright</groupId><artifactId>playwright</artifactId><version>1.40.0</version></dependency>
        <dependency><groupId>com.microsoft.playwright</groupId><artifactId>driver-bundle</artifactId><version>1.40.0</version></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><optional>true</optional></dependency>
        <!-- Literal versions on purpose: the CI image build copies this module
             under a parent pom that may predate the openpdf.version /
             jfreechart.version properties, which breaks POM parsing outright.
             Keep in sync with the root pom's dependencyManagement. -->
        <dependency><groupId>com.github.librepdf</groupId><artifactId>openpdf</artifactId><version>1.4.2</version></dependency>
        <dependency><groupId>org.jfree</groupId><artifactId>jfreechart</artifactId><version>1.5.6</version></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>-Xmx2048m</jvmArguments>
                    <classifier>exec</classifier>
                    <excludes><exclude><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></exclude></excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
