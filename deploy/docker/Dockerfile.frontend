# =============================================================================
# acquira-frontend image  (React build served by nginx, proxies /api -> core)
# =============================================================================

# ---- Stage 1: build the SPA ----
FROM node:22 AS build
WORKDIR /src
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build      # produces /src/dist

# ---- Stage 2: serve with nginx ----
FROM nginx:1.30-alpine
# Template, not a plain conf: the nginx image runs envsubst over
# /etc/nginx/templates/*.template at start, replacing ONLY variables that are
# set in the environment (so $host, $uri etc. are left alone).
ENV API_UPSTREAM=core:8081
COPY deploy/docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY deploy/docker/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /src/dist /usr/share/nginx/html

# Run as the image's unprivileged "nginx" user (uid 101), so: listen on 8080
# (see nginx.conf), keep the pid file in /tmp, and let that user write the
# rendered template into conf.d and its proxy/cache temp files.
RUN sed -i 's#^pid .*;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
    && chown -R 101:101 /etc/nginx/conf.d /var/cache/nginx
USER 101:101
EXPOSE 8080
