# Copy to secrets.env (git-ignored) and fill in. One KEY=value per line, no quotes.
# kustomize turns this into the "acquira-secrets" Secret for the dev overlay.
# On UAT/prod the Secret comes from AWS Secrets Manager instead (ExternalSecret).

# Also becomes POSTGRES_PASSWORD of the local DB pod (postgres.yaml reads this
# Secret). Must NOT be "postgres" or "CHANGE_ME": the pods run the prod profile
# and SecurityStartupGuard refuses to start with those.
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-db-password

# >= 32 chars. Every backend pod must share the same value (they all verify
# the same JWTs, and the pod-to-pod token is derived from it unless
# APP_INTERNAL_TOKEN below is set).
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Optional. Its own secret for pod-to-pod calls (core -> pdf /internal/**), so
# it can be rotated without touching user sessions. >= 32 random chars, same on
# every pod. Changing it needs core and pdf restarted together: while they
# disagree, statement renders are rejected.
#APP_INTERNAL_TOKEN=replace-with-at-least-32-random-characters

# AES key for stored SMTP/S3/integration secrets. Must be IDENTICAL on every pod
# and must NEVER change once data exists, or those secrets become undecryptable.
APP_ENCRYPTION_KEY=replace-with-exactly-32-characters!!
