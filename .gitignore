# ════════════════════════════════════════════════════════════
#  Acquira Platform — .gitignore
# ════════════════════════════════════════════════════════════

# ─── Maven Build Output ───
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
!.mvn/wrapper/*.jar

# ─── IDE ───
.idea/
*.iws
*.iml
*.ipr
.vscode/
.classpath
.project
.settings/
*.swp
*.swo
*~

# ─── Node.js / React Frontend ───
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Runtime Data (generated at runtime — never commit) ───
logs/
reports/
data/
temp/
backups/

# ─── Playwright Browser Binaries ───
.cache/ms-playwright/

# ─── Spring Boot ───
*.dump
hs_err_pid*

# ─── Log Files ───
*.log
compile*.log
build.log
temp_log.txt

# ─── OS Files ───
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Large Data Files (samples, uploads, test data) ───
*.xlsx
*.csv
*.sql.gz
test_report.pdf

# ─── Environment / Secrets ───
.env
.env.*
!.env.example
application-prod.properties

# ─── PowerShell Utility Scripts (local dev only) ───
*.ps1

# ─── Migration Artifacts ───
migration/
MIGRATION_GUIDE.md

# ─── Root-level loose src folder (if any — NOT the module src folders) ───
/src/
