# Auto-detect text files and normalize line endings to LF in the repo.
# Windows checkouts get CRLF automatically; Linux/Mac get LF.
* text=auto

# Explicit text files — always LF in repo
*.java          text eol=lf
*.xml           text eol=lf
*.properties    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.sql           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.sh            text eol=lf

# Windows batch/PowerShell — keep CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary files — never modify
*.xlsx          binary
*.xls           binary
*.csv           binary
*.pdf           binary
*.jar           binary
*.class         binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.zip           binary
*.gz            binary
