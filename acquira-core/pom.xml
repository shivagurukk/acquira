<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.acquira</groupId><artifactId>acquira-parent</artifactId><version>1.0.0-SNAPSHOT</version></parent>
    <artifactId>acquira-core</artifactId>
    <description>Main aggregator app - Auth, Analytics, Dashboards, Admin + Batch</description>
    <dependencies>
        <dependency><groupId>com.acquira</groupId><artifactId>acquira-common</artifactId></dependency>
        <dependency><groupId>com.acquira</groupId><artifactId>acquira-batch</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.acquira</groupId><artifactId>acquira-pdf</artifactId><version>${project.version}</version></dependency>
        <!-- AI Assistant (NL-to-SQL) — was missing; without this on the classpath,
             AiAssistantController/AiQueryService/ModelProvider beans cannot be found
             even after adding com.acquira.ai to CoreApplication's @ComponentScan. -->
        <dependency><groupId>com.acquira</groupId><artifactId>acquira-ai</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <!-- Mail: JavaMailSender, MimeMessageHelper (PDF statement attachments) -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-mail</artifactId></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><optional>true</optional></dependency>

        <!-- AWS SDK v2 S3 — version managed by parent BOM -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <!-- Needed by AWS SDK v2 for sync HTTP client -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>-Xmx2048m</jvmArguments>
                    <requiresUnpack>
                        <dependency>
                            <groupId>com.microsoft.playwright</groupId>
                            <artifactId>driver-bundle</artifactId>
                        </dependency>
                    </requiresUnpack>
                    <excludes><exclude><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></exclude></excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
