<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>com.acquira</groupId>
    <artifactId>acquira-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>Multi-module Merchant Analytics Platform</description>
    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.13.0</jjwt.version>
        <aws.sdk.version>2.55.11</aws.sdk.version>
        <lombok.version>1.18.48</lombok.version>
        <!-- Pin Spring Boot's managed JDBC driver versions to the patched
             releases so transitive resolution matches the direct declarations
             in acquira-batch (no version skew across modules). -->
        <mssql-jdbc.version>12.10.2.jre11</mssql-jdbc.version>
        <oracle-database.version>23.26.3.0.0</oracle-database.version>
        <!-- Held at 42.7.11 (Boot 4.1.1 manages 42.7.13). On 42.7.13 a large
             reWriteBatchedInserts batch with untyped date/timestamp binds
             (setTimestamp/setDate/setNull — every staging writer in
             acquira-batch) deadlocks: the driver blocks in sendBind while the
             server blocks in ClientWrite, and the ingest hangs forever.
             Deterministic with 16 KB socket buffers, intermittent on defaults;
             42.7.7 and 42.7.11 are immune down to 1 KB. Re-test a 100k-row
             upload with ...data-source-properties.receiveBufferSize=16384
             before raising this. -->
        <postgresql.version>42.7.11</postgresql.version>
        <openpdf.version>3.0.5</openpdf.version>
        <jfreechart.version>1.5.6</jfreechart.version>
        <!-- Smile ML (pure-JVM: no native BLAS needed for RandomForest) -->
        <smile.version>2.6.0</smile.version>
    </properties>
    <modules>
        <module>acquira-common</module>
        <module>acquira-batch</module>
        <module>acquira-pdf</module>
        <module>acquira-ai</module>
        <module>acquira-core</module>
    </modules>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>${jfreechart.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>

        <!-- ===== TEST DEPENDENCIES ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.acquira</groupId>
                <artifactId>acquira-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- AWS SDK v2 BOM — manages all AWS module versions centrally -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- OWASP dependency-check: .NET AssemblyAnalyzer disabled (no .NET assemblies
                 shipped; the Playwright driver jar bundles native driver packages that
                 otherwise force the dotnet 8.0 runtime as a build prerequisite). -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>13.0.0</version>
                <configuration>
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
